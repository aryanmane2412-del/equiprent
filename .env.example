# EQUIPRENT local development configuration.
# Copy to .env (scripts/setup.ps1 does this) and adjust. Never commit .env.
# The Go services load ./.env or ../.env automatically outside production.

# ---- Runtime --------------------------------------------------------------
APP_ENV=development             # development | test | staging | production
SERVICE_NAME=equiprent-api
LOG_LEVEL=debug                 # debug | info | warn | error
LOG_FORMAT=text                 # text (dev) | json (deployed)
SHUTDOWN_TIMEOUT=15s

# ---- HTTP -----------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_MAX_BODY_BYTES=1048576
# Comma-separated CIDRs of load balancers allowed to set X-Forwarded-For.
HTTP_TRUSTED_PROXIES=

# ---- CORS (web apps) ------------------------------------------------------
# Exact origins, comma-separated. In development any http://localhost:<port>
# is also allowed because CORS_ALLOW_LOCALHOST defaults to true there.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_LOCALHOST=true

# ---- PostgreSQL + PostGIS -------------------------------------------------
# Docker:  docker compose up -d   (publishes on localhost:5434)
# No Docker: scripts/db.ps1 start (native cluster on 5434, no PostGIS)
POSTGRES_USER=equiprent
POSTGRES_PASSWORD=equiprent_dev_password
POSTGRES_DB=equiprent
POSTGRES_PORT=5434
DATABASE_URL=postgres://equiprent:equiprent_dev_password@localhost:5434/equiprent?sslmode=disable
TEST_DATABASE_URL=postgres://equiprent:equiprent_dev_password@localhost:5434/equiprent_test?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s

# ---- Redis (optional in development) --------------------------------------
# Leave empty to run without Redis; readiness reports it as "disabled".
# With `docker compose --profile redis up -d`: redis://localhost:6379/0
REDIS_URL=
REDIS_PORT=6379
# Used only by the containerised api/worker (docker compose --profile app).
COMPOSE_REDIS_URL=

# ---- Worker ---------------------------------------------------------------
WORKER_HEARTBEAT_INTERVAL=30s

# ---- Docker compose ports -------------------------------------------------
API_PORT=8080
WEB_PORT=8081
WEB_API_BASE_URL=http://localhost:8080

# ---- Auth (phone OTP + JWT) -------------------------------------------------
# Development/test have built-in dev-only secrets; staging/production MUST set
# random values of at least 32 characters (the API refuses to start otherwise).
JWT_SECRET=
JWT_ISSUER=equiprent
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
OTP_SECRET=
OTP_TTL=5m
# Development simulation of SMS + email: OTPs and email tokens come back in API
# responses as dev_code / dev_token / dev_otp and nothing is sent. Defaults to
# true in development and test; refused in staging and production.
# (OTP_DEV_ECHO is still accepted as the old name.)
AUTH_DEV_SIMULATION=
# Optional configurable providers. The backend POSTs JSON with Bearer auth.
# SMS body: {to,message}; email body: {from,to,subject,body}.
# Use an HTTPS provider endpoint and a scoped API token. Do not commit secrets.
# SMS_PROVIDER=http_json enables SMS OTP. Email provider enables email OTP.
SMS_PROVIDER=
SMS_API_URL=
SMS_API_TOKEN=
EMAIL_PROVIDER=
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_FROM=

# ---- Verification documents & sensitive fields ------------------------------
# Identity and business documents are stored privately (never under a public
# path) and are only readable through short-lived signed links issued after an
# access check. Only the "local" driver is integrated today.
STORAGE_DRIVER=local
STORAGE_DIR=var/objects
# HMAC secret for signed download links (required, 32+ chars outside development).
STORAGE_SIGNING_SECRET=
# Lifetime of document links (max 15m) and profile-image links.
STORAGE_URL_TTL=5m
STORAGE_AVATAR_URL_TTL=1h
STORAGE_MAX_UPLOAD_BYTES=10485760
# AES-256-GCM key for PAN, licence, document and bank account numbers:
# 32 random bytes, base64 (openssl rand -base64 32). Required outside development.
FIELD_ENCRYPTION_KEY=
# HMAC key for duplicate detection of encrypted numbers (32+ chars).
LOOKUP_HASH_KEY=
# Password sign-in lockout: attempts per email/phone per window.
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW=15m
AUTH_EMAIL_TOKEN_TTL=24h
AUTH_RESET_TOKEN_TTL=30m

# ---- Rate limiting (shared through Redis when REDIS_URL is set) -------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20

# ---- Payments (Razorpay) -----------------------------------------------------
# Leave the keys empty for SANDBOX mode: orders are simulated and the create-
# payment response includes a ready-signed "sandbox" verify payload.
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ---- Push notifications (Firebase Cloud Messaging) -----------------------------
# Service-account key from Firebase console -> Project settings -> Service
# accounts -> Generate new private key: a file path or the JSON itself. Empty =
# pushes are only logged (in-app notifications always work).
FCM_CREDENTIALS=
FCM_PROJECT_ID=                   # optional; defaults to the key's project_id
APP_PUBLIC_URL=                   # opened when a web push is clicked, e.g. https://app.equiprent.in

# ---- Rental agreement e-signatures ----------------------------------------------
# builtin: acceptance record (typed name + consent, bound to the text's SHA-256);
#          NOT a digital signature / Aadhaar eSign (default).
# sandbox: simulates an external provider's redirect + webhook flow (dev only).
ESIGN_PROVIDER=builtin
ESIGN_WEBHOOK_SECRET=

# Documents compliance gate (docs/BACKEND.md section 3e). When true, agreements
# are refused unless the published terms have a recorded legal review, and
# invoices are refused while an active tax rule has no recorded review.
# Defaults: on in staging/production (cannot be off in production), off otherwise.
LEGAL_REQUIRE_REVIEWED=

# ---- Booking policy ------------------------------------------------------------
BOOKING_OWNER_RESPONSE_WINDOW=2h
BOOKING_ADVANCE_BPS=5000          # 50% of the estimate due on confirmation
GST_RATE_BPS=1800                 # 18%
BOOKING_DEFAULT_DEPOSIT_PAISE=0
BOOKING_PAYMENT_WINDOW=24h          # online bookings pay the advance within this after acceptance, else they expire
BOOKING_PAYMENT_PROCESSING_TIMEOUT=30m  # an abandoned checkout returns to awaiting payment

# ---- Maps (optional) -------------------------------------------------------------
# Google Maps Platform server key (Geocoding + Directions APIs): resolves PIN
# codes missing from the reference table and gives road ETAs for tracking
# (without it ETAs are straight-line estimates). Restrict it by server IP; it
# is never sent to clients or logged. Leave empty in development: search uses the
# built-in PIN code table and the app draws its own map. The Flutter app takes
# its own browser/app key: flutter run --dart-define=GOOGLE_MAPS_API_KEY=...
GOOGLE_MAPS_API_KEY=

# ---- Location tracking ----------------------------------------------------------
# Accept simulated GPS uploads and the "simulated" tracker provider. Defaults to
# true outside production; production refuses to start with it on.
TRACKING_ALLOW_SIMULATED=
# Close sharing sessions with no upload for this long (minimum 10m).
TRACKING_IDLE_TIMEOUT=3h
# Lifetime of WebSocket tickets (maximum 10m).
TRACKING_TICKET_TTL=1m
# Version of the tracking notice users accept; bump it when the text changes so
# everyone is asked again.
TRACKING_POLICY_VERSION=2026-11

# ---- API docs ------------------------------------------------------------------
# Swagger UI at /docs and the spec at /api/v1/openapi.json (default: on outside production).
API_DOCS_ENABLED=
API_PUBLIC_URL=http://localhost:8080

# ---- Owner payouts (RazorpayX) ------------------------------------------------------
# Empty = no automatic payouts: settlements become "eligible" and owners are paid manually.
# razorpayx = bank accounts are verified with a penny drop and payouts are sent over IMPS.
# Needs REAL PAYMENT_KEY_ID / PAYMENT_KEY_SECRET (use rzp_test_ keys first) and a funded
# RazorpayX account. The API and the worker refuse to start if these are inconsistent.
PAYOUT_PROVIDER=
RAZORPAYX_ACCOUNT_NUMBER=
PAYOUT_MODE=IMPS                  # IMPS | NEFT | RTGS | UPI
PAYOUT_MAX_PAISE=20000000         # per-payout cap (INR 2,00,000); larger settlements wait for a person
PAYOUT_BANK_COOLDOWN=24h          # payouts wait this long after an owner adds/changes the payout account

# Copy to .env.production and fill EVERY value. Never commit the real file.
# Generate secrets with:  openssl rand -base64 48
#   FIELD_ENCRYPTION_KEY must be exactly 32 bytes:  openssl rand -base64 32
# Use a DIFFERENT value for each secret.

APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

POSTGRES_PASSWORD=
REDIS_PASSWORD=

JWT_SECRET=
OTP_SECRET=
STORAGE_SIGNING_SECRET=
FIELD_ENCRYPTION_KEY=
LOOKUP_HASH_KEY=
STORAGE_DRIVER=local

# Real SMS + email providers (OTP login is impossible without them in production).
SMS_PROVIDER=http_json
SMS_API_URL=
SMS_API_TOKEN=
EMAIL_PROVIDER=http_json
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_FROM=

# Razorpay LIVE keys (sandbox is refused in production).
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Owner payouts. Leave PAYOUT_PROVIDER empty to pay owners manually.
# To go live: first run with rzp_test_ keys and a RazorpayX test account (see infrastructure/deployment/README.md).
PAYOUT_PROVIDER=
RAZORPAYX_ACCOUNT_NUMBER=
PAYOUT_MODE=IMPS
PAYOUT_MAX_PAISE=20000000
PAYOUT_BANK_COOLDOWN=24h
